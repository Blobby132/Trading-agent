__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/
.venv/
env/
data/cache/*
!data/cache/.gitkeep
results/*
!results/.gitkeep
# Paper-trading state and the research ledgers are the record of a live
# experiment, not build output. They have to survive a machine being rebuilt,
# so they are tracked deliberately.
!results/paper_account.json
!results/research_ledger.jsonl
!results/holdout_ledger.json
.DS_Store
# Sweep results are the evidence behind docs/INTERVAL_FREQUENCY.md. A report
# whose numbers cannot be traced back to the run that produced them is just an
# assertion, so the result files are tracked deliberately.
!results/sweeps/
!results/sweeps/**
# Edge-improvement evidence, same principle as results/sweeps: a report whose
# numbers cannot be traced back to the run that produced them is an assertion.
!results/edge/
!results/edge/**
!results/edge2/
!results/edge2/**
!results/mechanism/
!results/mechanism/**
!results/validation/
!results/validation/**
